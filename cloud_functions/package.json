{
  "name": "farm-fintech-functions",
  "version": "1.0.0",
  "description": "Cloud Functions for Farm FinTech game — credit scoring, weather checks, BNPL, loans, insurance",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "firebase-admin": "^13.8.0",
    "firebase-functions": "^7.2.5",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/node-fetch": "^2.6.13",
    "typescript": "^5.3.0"
  },
  "private": true
}
